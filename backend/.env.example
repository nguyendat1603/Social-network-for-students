PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase Online Database Configuration (Fill in your own keys in backend/.env)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional Direct Postgres URL for Prisma CLI migrations
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# JWT & Auth Settings
JWT_ACCESS_SECRET=replace_with_strong_random_access_secret
JWT_REFRESH_SECRET=replace_with_strong_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Allowed University Email Domains (.edu whitelist)
ALLOWED_EDU_DOMAINS=sis.hust.edu.vn,hust.edu.vn,vnu.edu.vn,fpt.edu.vn,ptit.edu.vn,uet.vnu.edu.vn,neu.edu.vn,hcmut.edu.vn,uit.edu.vn,edu.vn,edu

# OTP Settings
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
ANONYMOUS_HANDLE_COOLDOWN_DAYS=30
